{
    "CPSUBSCRIBE": {
        "summary": "Listens for messages published to channels matching patterns, delivering only the latest value per channel and interval.",
        "complexity": "O(N) where N is the number of patterns to subscribe to.",
        "group": "pubsub",
        "since": "9.2.0",
        "arity": -2,
        "function": "cpsubscribeCommand",
        "command_flags": [
            "PUBSUB",
            "NOSCRIPT",
            "LOADING",
            "STALE",
            "SENTINEL"
        ],
        "arguments": [
            {
                "name": "pattern",
                "type": "pattern",
                "multiple": true
            }
        ],
        "acl_categories": [
            "PUBSUB",
            "SLOW"
        ]
    }
}
